# --- App DB (default: single SQLite file; use .[postgres] + Postgres URL when you outgrow it) ---
DATABASE_URL=sqlite:///./quack.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/quack
ADMIN_BOOTSTRAP_KEY=change-me-long-random

# Migrations: set false only if you run Alembic separately
RUN_MIGRATIONS_ON_STARTUP=true

# --- Chroma (API talks to server; optional local: chromadb/docker-compose.yml) ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_AUTH_TOKEN=your-shared-token

# --- Azure OpenAI (shared fallbacks when model-specific vars are unset) ---
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://quackgpt-llm.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

AZURE_OPENAI_NANO_ENDPOINT=
AZURE_OPENAI_NANO_API_KEY=
AZURE_OPENAI_NANO_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_NANO_TEMPERATURE=1

# Optional: Google (Gemini models in llm service)
GOOGLE_API_KEY=

# --- Microsoft Entra (JWT Bearer to the API; required unless AUTH_DISABLED) ---
ENTRA_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
ENTRA_AUDIENCE=api://<your-api-app-client-id>
ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# Optional: auto-create users on first login (tier: everyone|students|members|board)
ENTRA_AUTO_PROVISION_TIER=

# Local dev only — never in prod
AUTH_DISABLED=false
DEV_IMPERSONATE_USER_EMAIL=

# --- Optional SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- CLI ingest (see quack_db.ingest.cli) ---
QUACK_API_URL=http://127.0.0.1:8000
QUACK_BEARER_TOKEN=


# Azure OpenAI (shared fallbacks when model-specific vars are unset)
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://quackgpt-llm.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Embedding model (leave endpoint/key empty to use shared values above)
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Nano / chat model (leave endpoint/key empty to use shared values above)
# Temperature: o1/o1-mini only support 1; use 0.2 for gpt-4o-mini etc.
AZURE_OPENAI_NANO_ENDPOINT=
AZURE_OPENAI_NANO_API_KEY=
AZURE_OPENAI_NANO_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_NANO_TEMPERATURE=1

# Optional: Google (for Gemini models)
GOOGLE_API_KEY=...

# ChromaDB (TokenAuthClientProvider / X-Chroma-Token)
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_AUTH_TOKEN=your-secret-token

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    API_BASE_URL=http://api:8001

WORKDIR /app

# Use requirements.txt as single source of truth for dependency versions.
COPY requirements.txt /app/requirements.txt

RUN pip install --upgrade pip && \
    pip install -r /app/requirements.txt

# Runtime secrets should be injected by the platform (Container Apps / Key Vault),
# not baked into images.
# Copy only the modules/config needed for Dash runtime.
COPY services /app/services
COPY ui /app/ui
COPY app_config.py /app/app_config.py

EXPOSE 8050

CMD ["python", "-m", "ui"]


